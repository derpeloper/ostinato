                },
                "new": {
                  "name": "neu",
                  "description": "der neue ersatzfilter"
                }
              }
            },
            "remove": {
              "name": "entfernen",
              "description": "einen filter entfernen",
              "options": {
                "string": {
                  "name": "text",
                  "description": "filtertext oder regex zum entfernen"
                }
              }
            }
