      "description": "leert die tts-warteschlange für diesen server"
    },
    "restrict": {
      "name": "einschränken",
      "description": "deaktiviert tts für nutzer, die nicht stummgeschaltet sind"
    },
    "skip": {
      "name": "überspringen",
      "description": "überspringt die aktuell abgespielte nachricht"
    },
