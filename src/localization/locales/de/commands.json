              "options": {
                "language": {
                  "name": "sprache",
                  "description": "die festzulegende sprache"
                }
              }
            },
            "reset": {
              "name": "zurücksetzen",
              "description": "die standard-sprache für den server zurücksetzen"
            }
          }
        }
      }
    },
    "message": {
