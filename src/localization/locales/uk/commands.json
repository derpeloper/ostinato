{
  "mods": {
    "clear": {
      "name": "очистити",
      "description": "очищає чергу tts для цього сервера"
    },
    "restrict": {
      "name": "обмежити",
      "description": "вимкнути tts для користувачів, які не мають вимкненого звуку"
    },
    "skip": {
      "name": "пропустити",
      "description": "пропускає повідомлення, що зараз відтворюється"
    },
    "unrestrict": {
      "name": "зняти-обмеження",
      "description": "увімкнути tts для користувачів, які не мають вимкненого звуку"
    },
    "guild": {
      "name": "сервер",
      "description": "керування налаштуваннями сервера",
      "groups": {
        "lang": {
          "name": "мова",
          "description": "керування мовою сервера за замовчуванням",
          "subcommands": {
            "set": {
              "name": "встановити",
              "description": "встановлює мову за замовчуванням для сервера",
              "options": {
                "language": {
                  "name": "мова",
                  "description": "мова, яку потрібно встановити"
                }
              }
            },
            "reset": {
              "name": "скинути",
              "description": "скидає мову сервера за замовчуванням"
            }
          }
        }
      }
    },
    "message": {
      "name": "повідомлення",
      "description": "керування фільтрами вмісту повідомлень",
      "groups": {
        "filter": {
          "name": "фільтр",
          "description": "керування фільтрами вмісту",
          "subcommands": {
            "add": {
              "name": "додати",
              "description": "додати новий фільтр",
              "options": {
                "string": {
                  "name": "рядок",
                  "description": "текст фільтра або регулярний вираз"
                }
              }
            },
            "list": {
              "name": "список",
              "description": "показати всі активні фільтри"
            },
            "edit": {
              "name": "редагувати",
              "description": "редагувати існуючий фільтр",
              "options": {
                "old": {
                  "name": "старий",
                  "description": "існуючий фільтр для редагування"
                },
                "new": {
                  "name": "новий",
                  "description": "новий фільтр для заміни"
                }
              }
            },
            "remove": {
              "name": "видалити",
              "description": "видалити фільтр",
              "options": {
                "string": {
                  "name": "рядок",
                  "description": "текст фільтра або регулярний вираз для видалення"
                }
              }
            }
          }
        }
      }
    },
    "channel": {
      "name": "канал",
      "description": "керування альтернативним чат-каналом сервера",
      "subcommands": {
        "set": {
          "name": "встановити",
          "description": "призначити канал як альтернативний чат",
          "options": {
            "channel": {
              "name": "канал",
              "description": "канал, який потрібно встановити"
            }
          }
        },
        "remove": {
          "name": "видалити",
          "description": "видалити поточний альтернативний чат-канал"
        }
      }
    }
  },
  "public": {
    "help": {
      "name": "допомога",
      "description": "надає інформацію про команди",
      "options": {
        "command": {
          "name": "команда",
          "description": "команда, про яку потрібна інформація"
        }
      }
    },
    "info": {
      "name": "інфо",
      "description": "надає інформацію про бота"
    },
    "lang": {
      "name": "мова",
      "description": "змінити мову tts для вашого акаунта",
      "options": {
        "language": {
          "name": "мова",
          "description": "мова, яку використовувати"
        }
      }
    },
    "leave": {
      "name": "вийти",
      "description": "від’єднує бота від голосового каналу"
    },
    "name": {
      "name": "імя",
      "description": "встановити відображуване ім'я або керувати фільтрами імен",
      "subcommands": {
        "set": {
          "name": "встановити",
          "description": "встановити ваше відображуване ім'я",
          "options": {
            "string": {
              "name": "рядок",
              "description": "ім'я, яке потрібно встановити"
            }
          }
        }
      },
      "groups": {
        "filter": {
          "name": "фільтр",
          "description": "керування фільтрами імен",
          "subcommands": {
            "add": {
              "name": "додати",
              "description": "додати новий фільтр",
              "options": {
                "string": {
                  "name": "рядок",
                  "description": "текст фільтра або регулярний вираз"
                }
              }
            },
            "list": {
              "name": "список",
              "description": "показати всі активні фільтри"
            },
            "edit": {
              "name": "редагувати",
              "description": "редагувати існуючий фільтр",
              "options": {
                "old": {
                  "name": "старий",
                  "description": "існуючий фільтр для редагування"
                },
                "new": {
                  "name": "новий",
                  "description": "новий фільтр для заміни"
                }
              }
            },
            "remove": {
              "name": "видалити",
              "description": "видалити фільтр",
              "options": {
                "string": {
                  "name": "рядок",
                  "description": "текст фільтра або регулярний вираз для видалення"
                }
              }
            }
          }
        }
      }
    },
    "reset": {
      "name": "скинути",
      "description": "скидає ваші налаштування tts до стандартних",
      "options": {
        "option": {
          "name": "опція",
          "description": "конкретне налаштування для скидання"
        }
      }
    },
    "settings": {
      "name": "налаштування",
      "description": "перевірити ваші поточні налаштування tts"
    },
    "speed": {
      "name": "швидкість",
      "description": "змінити швидкість tts для вашого акаунта",
      "options": {
        "value": {
          "name": "значення",
          "description": "множник швидкості (від 0.5 до 2.0)"
        }
      }
    },
    "tts": {
      "name": "tts",
      "description": "керування вашими уподобаннями tts",
      "options": {
        "on": {
          "name": "увімк",
          "description": "увімкнути tts для ваших повідомлень"
        },
        "off": {
          "name": "вимк",
          "description": "вимкнути tts для ваших повідомлень"
        }
      }
    },
    "voice": {
      "name": "голос",
      "description": "змінити голос для вашого акаунта"
    }
  }
}
