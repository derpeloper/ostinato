{
  "mods": {
    "clear": {
      "name": "limpiar",
      "description": "limpia la cola de tts para este servidor"
    },
    "restrict": {
      "name": "restringir",
      "description": "desactiva el tts para los usuarios que no están silenciados"
    },
    "skip": {
      "name": "saltar",
      "description": "salta el mensaje que se está reproduciendo actualmente"
    },
    "unrestrict": {
      "name": "desrestringir",
      "description": "activa el tts para los usuarios que no están silenciados"
    },
    "guild": {
      "name": "servidor",
      "description": "gestionar ajustes específicos del servidor",
      "groups": {
        "lang": {
          "name": "idioma",
          "description": "gestionar el idioma predeterminado del servidor",
          "subcommands": {
            "set": {
              "name": "establecer",
              "description": "establece el idioma predeterminado del servidor",
              "options": {
                "language": {
                  "name": "idioma",
                  "description": "el idioma a establecer"
                }
              }
            },
            "reset": {
              "name": "restablecer",
              "description": "restablece el idioma predeterminado del servidor"
            }
          }
        }
      }
    },
    "message": {
      "name": "mensaje",
      "description": "gestionar filtros de contenido de mensajes",
      "groups": {
        "filter": {
          "name": "filtro",
          "description": "gestionar filtros de contenido",
          "subcommands": {
            "add": {
              "name": "agregar",
              "description": "agregar un nuevo filtro",
              "options": {
                "string": {
                  "name": "texto",
                  "description": "el texto o regex del filtro a agregar"
                }
              }
            },
            "list": {
              "name": "lista",
              "description": "listar todos los filtros activos"
            },
            "edit": {
              "name": "editar",
              "description": "editar un filtro existente",
              "options": {
                "old": {
                  "name": "anterior",
                  "description": "el filtro existente a editar"
                },
                "new": {
                  "name": "nuevo",
                  "description": "el nuevo filtro de reemplazo"
                }
              }
            },
            "remove": {
              "name": "eliminar",
              "description": "eliminar un filtro",
              "options": {
                "string": {
                  "name": "texto",
                  "description": "el texto o regex del filtro a eliminar"
                }
              }
            }
          }
        }
      }
    },
    "channel": {
      "name": "canal",
      "description": "gestionar el canal de chat alternativo del servidor",
      "subcommands": {
        "set": {
          "name": "establecer",
          "description": "establecer un canal como chat alternativo",
          "options": {
            "channel": {
              "name": "canal",
              "description": "el canal a establecer"
            }
          }
        },
        "remove": {
          "name": "eliminar",
          "description": "eliminar el canal de chat alternativo actual"
        }
      }
    }
  },
  "public": {
    "help": {
      "name": "ayuda",
      "description": "proporciona información sobre los comandos",
      "options": {
        "command": {
          "name": "comando",
          "description": "el comando sobre el que obtener información"
        }
      }
    },
    "info": {
      "name": "info",
      "description": "proporciona información sobre el bot"
    },
    "lang": {
      "name": "idioma",
      "description": "cambia el idioma del tts para tu cuenta",
      "options": {
        "language": {
          "name": "idioma",
          "description": "el idioma a usar"
        }
      }
    },
    "leave": {
      "name": "salir",
      "description": "desconecta al bot del canal de voz"
    },
    "name": {
      "name": "nombre",
      "description": "establece tu nombre o gestiona filtros de nombres",
      "subcommands": {
        "set": {
          "name": "establecer",
          "description": "establece tu nombre para mostrar",
          "options": {
            "string": {
              "name": "texto",
              "description": "el nombre a establecer"
            }
          }
        }
      },
      "groups": {
        "filter": {
          "name": "filtro",
          "description": "gestionar filtros de nombres",
          "subcommands": {
            "add": {
              "name": "agregar",
              "description": "agregar un nuevo filtro",
              "options": {
                "string": {
                  "name": "texto",
                  "description": "el texto o regex del filtro a agregar"
                }
              }
            },
            "list": {
              "name": "lista",
              "description": "listar todos los filtros activos"
            },
            "edit": {
              "name": "editar",
              "description": "editar un filtro existente",
              "options": {
                "old": {
                  "name": "anterior",
                  "description": "el filtro existente a editar"
                },
                "new": {
                  "name": "nuevo",
                  "description": "el nuevo filtro de reemplazo"
                }
              }
            },
            "remove": {
              "name": "eliminar",
              "description": "eliminar un filtro",
              "options": {
                "string": {
                  "name": "texto",
                  "description": "el texto o regex del filtro a eliminar"
                }
              }
            }
          }
        }
      }
    },
    "reset": {
      "name": "restablecer",
      "description": "restablece tus ajustes de tts a los valores predeterminados",
      "options": {
        "option": {
          "name": "opción",
          "description": "el ajuste específico a restablecer"
        }
      }
    },
    "settings": {
      "name": "ajustes",
      "description": "comprueba tus ajustes actuales de tts"
    },
    "speed": {
      "name": "velocidad",
      "description": "cambia la velocidad del tts para tu cuenta",
      "options": {
        "value": {
          "name": "valor",
          "description": "el multiplicador de velocidad (0.5 a 2.0)"
        }
      }
    },
    "tts": {
      "name": "tts",
      "description": "gestiona tus preferencias de tts",
      "options": {
        "on": {
          "name": "activar",
          "description": "activa el tts para tus mensajes"
        },
        "off": {
          "name": "desactivar",
          "description": "desactiva el tts para tus mensajes"
        }
      }
    },
    "voice": {
      "name": "voz",
      "description": "cambia la voz para tu cuenta"
    }
  }
}
