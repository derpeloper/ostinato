{
  "mods": {
    "clear": {
      "name": "clear",
      "description": "clears the tts queue for this server"
    },
    "restrict": {
      "name": "restrict",
      "description": "disable tts for users who aren't muted"
    },
    "skip": {
      "name": "skip",
      "description": "skips the currently playing message"
    },
    "unrestrict": {
      "name": "unrestrict",
      "description": "enable tts for users who aren't muted"
    },
    "autojoin": {
      "name": "autojoin",
      "description": "toggle the bot automatically joining voice channels"
    },
    "guild": {
      "name": "guild",
      "description": "manage guild-specific settings",
      "groups": {
        "lang": {
          "name": "lang",
          "description": "manage default guild language",
          "subcommands": {
            "set": {
              "name": "set",
              "description": "set the default language for the guild",
              "options": {
                "language": {
                  "name": "language",
                  "description": "the language to set"
                }
              }
            },
            "reset": {
              "name": "reset",
              "description": "reset the default language for the guild"
            }
          }
        }
      }
    },
    "message": {
      "name": "message",
      "description": "manage message content filters",
      "groups": {
        "filter": {
          "name": "filter",
          "description": "manage content filters",
          "subcommands": {
            "add": {
              "name": "add",
              "description": "add a new filter",
              "options": {
                "string": {
                  "name": "string",
                  "description": "the filter text or regex to add"
                }
              }
            },
            "list": {
              "name": "list",
              "description": "list all active filters"
            },
            "edit": {
              "name": "edit",
              "description": "edit an existing filter",
              "options": {
                "old": {
                  "name": "old",
                  "description": "the existing filter to edit"
                },
                "new": {
                  "name": "new",
                  "description": "the new replacement filter"
                }
              }
            },
            "remove": {
              "name": "remove",
              "description": "remove a filter",
              "options": {
                "string": {
                  "name": "string",
                  "description": "the filter text or regex to remove"
                }
              }
            }
          }
        }
      }
    },
    "channel": {
      "name": "channel",
      "description": "manage the guild's alternative chat channel",
      "subcommands": {
        "set": {
          "name": "set",
          "description": "set a channel as the alternative chat",
          "options": {
            "channel": {
              "name": "channel",
              "description": "the channel to set"
            }
          }
        },
        "remove": {
          "name": "remove",
          "description": "remove the current alternative chat channel"
        }
      }
    }
  },
  "public": {
    "help": {
      "name": "help",
      "description": "provides information for commands",
      "options": {
        "command": {
          "name": "command",
          "description": "the command to get information about"
        }
      }
    },
    "info": {
      "name": "info",
      "description": "provides information about the bot"
    },
    "inject": {
      "name": "inject",
      "description": "send a message to the voice channel without joining",
      "options": {
        "message": {
          "name": "message",
          "description": "the message to inject (max 200 chars)"
        }
      }
    },
    "lang": {
      "name": "lang",
      "description": "change the language of the tts for your account",
      "options": {
        "language": {
          "name": "language",
          "description": "the language to use"
        }
      }
    },
    "leave": {
      "name": "leave",
      "description": "disconnects the bot from the voice channel"
    },
    "name": {
      "name": "name",
      "description": "set your display name or manage name filters",
      "subcommands": {
        "set": {
          "name": "set",
          "description": "set your display name",
          "options": {
            "string": {
              "name": "string",
              "description": "the name to set"
            }
          }
        }
      },
      "groups": {
        "filter": {
          "name": "filter",
          "description": "manage name filters",
          "subcommands": {
            "add": {
              "name": "add",
              "description": "add a new filter",
              "options": {
                "string": {
                  "name": "string",
                  "description": "the filter text or regex to add"
                }
              }
            },
            "list": {
              "name": "list",
              "description": "list all active filters"
            },
            "edit": {
              "name": "edit",
              "description": "edit an existing filter",
              "options": {
                "old": {
                  "name": "old",
                  "description": "the existing filter to edit"
                },
                "new": {
                  "name": "new",
                  "description": "the new replacement filter"
                }
              }
            },
            "remove": {
              "name": "remove",
              "description": "remove a filter",
              "options": {
                "string": {
                  "name": "string",
                  "description": "the filter text or regex to remove"
                }
              }
            }
          }
        }
      }
    },
    "reset": {
      "name": "reset",
      "description": "resets your tts settings to default",
      "options": {
        "option": {
          "name": "option",
          "description": "the specific setting to reset"
        }
      }
    },
    "settings": {
      "name": "settings",
      "description": "check your current tts settings"
    },
    "speed": {
      "name": "speed",
      "description": "change the speed of the tts for your account",
      "options": {
        "value": {
          "name": "value",
          "description": "the speed multiplier (0.5 to 2.0)"
        }
      }
    },
    "tts": {
      "name": "tts",
      "description": "manage your tts preferences",
      "options": {
        "on": {
          "name": "on",
          "description": "turn on tts for your messages"
        },
        "off": {
          "name": "off",
          "description": "turn off tts for your messages"
        }
      }
    },
    "voice": {
      "name": "voice",
      "description": "change the voice for your account"
    }
  }
}
