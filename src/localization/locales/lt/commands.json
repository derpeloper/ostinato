          "name": "filtras",
          "description": "valdyti vardų filtrus",
          "subcommands": {
            "add": {
              "name": "pridėti",
              "description": "pridėti naują filtrą",
              "options": {
                "string": {
                  "name": "tekstas",
                  "description": "filtro tekstas arba regex"
                }
              }
            },
            "list": {
              "name": "sąrašas",
              "description": "išvardyti visus aktyvius filtrus"
            },
            "edit": {
              "name": "redaguoti",
              "description": "redaguoti esamą filtrą",
              "options": {
                "old": {
                  "name": "senas",
                  "description": "esamas filtras, kurį norite redaguoti"
                },
                "new": {
                  "name": "naujas",
                  "description": "naujas pakaitinis filtras"
                }
              }
            },
            "remove": {
              "name": "pašalinti",
              "description": "pašalinti filtrą",
              "options": {
                "string": {
                  "name": "tekstas",
                  "description": "filtro tekstas arba regex, kurį norite pašalinti"
                }
              }
            }
          }
        }
      }
    },
    "reset": {
      "name": "atstatyti",
      "description": "atstato tts nustatymus į numatytuosius",
      "options": {
        "option": {
          "name": "parinktis",
          "description": "konkretus nustatymas, kurį norite atstatyti"
        }
      }
    },
    "settings": {
      "name": "nustatymai",
      "description": "patikrinti esamus tts nustatymus"
    },
    "speed": {
      "name": "greitis",
      "description": "pakeisti tts greitį jūsų paskyrai",
      "options": {
        "value": {
          "name": "reikšmė",
          "description": "greičio daugiklis (nuo 0.5 iki 2.0)"
        }
      }
    },
    "tts": {
      "name": "tts",
      "description": "valdyti tts nustatymus",
      "options": {
        "on": {
          "name": "įjungti",
          "description": "įjungti tts jūsų žinutėms"
        },
        "off": {
          "name": "išjungti",
          "description": "išjungti tts jūsų žinutėms"
        }
      }
    },
    "voice": {
      "name": "balsas",
      "description": "pakeisti balsą jūsų paskyrai"
