{
  "mods": {
    "clear": {
      "name": "șterge",
      "description": "șterge coada tts pentru acest server"
    },
    "restrict": {
      "name": "restricționează",
      "description": "dezactivează tts pentru utilizatorii care nu sunt amuțiți"
    },
    "skip": {
      "name": "sari",
      "description": "sare peste mesajul care se redă în prezent"
    },
