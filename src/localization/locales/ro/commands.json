              "options": {
                "string": {
                  "name": "text",
                  "description": "textul filtrului sau regex-ul de adăugat"
                }
              }
            },
            "list": {
              "name": "listă",
              "description": "listează toate filtrele active"
            },
            "edit": {
              "name": "editează",
              "description": "editează un filtru existent",
              "options": {
                "old": {
                  "name": "vechi",
                  "description": "filtrul existent de editat"
                },
                "new": {
                  "name": "nou",
                  "description": "noul filtru de înlocuire"
                }
              }
            },
            "remove": {
              "name": "elimină",
              "description": "elimină un filtru",
              "options": {
                "string": {
                  "name": "text",
                  "description": "textul filtrului sau regex-ul de eliminat"
                }
              }
            }
          }
        }
      }
    },
    "channel": {
      "name": "canal",
