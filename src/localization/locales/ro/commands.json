          "subcommands": {
            "set": {
              "name": "setează",
              "description": "setează limba implicită pentru server",
              "options": {
                "language": {
                  "name": "limbă",
                  "description": "limba de setat"
                }
              }
            },
            "reset": {
              "name": "resetează",
              "description": "resetează limba implicită pentru server"
            }
          }
        }
      }
    },
    "message": {
