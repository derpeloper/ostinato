          "name": "dil",
          "description": "varsayılan sunucu dilini yönetir",
          "subcommands": {
            "set": {
              "name": "ayarla",
              "description": "sunucu için varsayılan dili ayarlar",
              "options": {
                "language": {
                  "name": "dil",
                  "description": "ayarlanacak dil"
                }
              }
            },
            "reset": {
              "name": "sıfırla",
              "description": "sunucunun varsayılan dilini sıfırlar"
            }
          }
        }
      }
    },
    "message": {
