          "subcommands": {
            "add": {
              "name": "ekle",
              "description": "yeni bir filtre ekler",
              "options": {
                "string": {
                  "name": "metin",
                  "description": "eklenecek filtre metni veya düzenli ifade (regex)"
                }
              }
            },
            "list": {
              "name": "listele",
              "description": "tüm aktif filtreleri listeler"
            },
            "edit": {
              "name": "düzenle",
              "description": "mevcut bir filtreyi düzenler",
              "options": {
                "old": {
                  "name": "eski",
                  "description": "düzenlenecek mevcut filtre"
                },
                "new": {
                  "name": "yeni",
                  "description": "yeni yedek filtre"
                }
              }
            },
            "remove": {
              "name": "kaldır",
              "description": "bir filtreyi kaldırır",
              "options": {
                "string": {
                  "name": "metin",
                  "description": "kaldırılacak filtre metni veya düzenli ifade (regex)"
                }
              }
            }
          }
        }
      }
    },
    "channel": {
      "name": "kanal",
